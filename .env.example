# Copy this file to `.env`, fill in the block below, then run:
#     python main.py check
# which tells you whether the configuration is complete before you spend a
# real call, and `--ping` sends one tiny request to prove the key works.

# --- Any OpenAI-compatible endpoint ------------------------------------------
# OpenAI itself, OpenRouter, Together, vLLM, Ollama, LM Studio, a university
# endpoint -- they all speak the same protocol. Set the key AND the endpoint:
# your key is sent to whatever OPENAI_BASE_URL points at, so leaving someone
# else's URL here would send your key to them.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# The model names. Required: pick models your endpoint serves. The vision model
# must accept images; the text model does not need to.
KG_VISION_MODEL=
KG_TEXT_MODEL=

# --- Reproducing the published numbers ---------------------------------------
# The 0.527 strict triplet F1 in README.md was measured on an academic endpoint
# (chat-ai.academiccloud.de) with these settings. They are here for the record;
# you need an account on that endpoint for them to work.
#
#OPENAI_BASE_URL=https://chat-ai.academiccloud.de/v1
#KG_VISION_MODEL=qwen3.5-122b-a10b
#KG_TEXT_MODEL=deepseek-v4-flash

# --- Optional ----------------------------------------------------------------
# Seconds per LLM call before it is retried. The densest figures need more than
# the default; see the timeout note in README.md.
#KG_REQUEST_TIMEOUT=300
